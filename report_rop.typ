== 3. Персональные результаты сотрудников (детализация по рубрикам)

#let employee_card(name, time, score, percent, items) = [
  #block(width: 100%, stroke: 0.5pt + rgb("#d0d0d0"), inset: 10pt, radius: 4pt, fill: rgb("#fcfcfc"))[
    #grid(
      columns: (1fr, auto),
      [
        #text(weight: "bold", size: 10.5pt, fill: rgb("#1B4D3E"))[#name] \
        #text(size: 8pt, fill: rgb("#666666"))[Время сдачи: #time]
      ],
      align(right)[
        #text(weight: "bold", size: 10.5pt, fill: rgb("#23633F"))[#score (#percent%)]
      ]
    )
    #v(0.12cm)
    #line(length: 100%, stroke: 0.3pt + rgb("#e0e0e0"))
    #v(0.12cm)
    #grid(
      columns: (1fr, 1fr, 1fr),
      gutter: 6pt,
      ..items.map(it => text(size: 8pt)[#it])
    )
  ]
  #v(0.25cm)
]

